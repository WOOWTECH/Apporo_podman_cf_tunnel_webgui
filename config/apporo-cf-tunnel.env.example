# apporo-cf-tunnel (Apporo CF Tunnel Web) install-time settings.
# scripts/install.sh copies this to ~/.config/apporo-cf-tunnel/apporo-cf-tunnel.env (mode
# 0600) on the first run, then renders these values into the Quadlet units. The containers
# never read this file. After an edit, apply it with scripts/upgrade.sh (the tunnel
# unit) or scripts/install.sh (the optional auth proxy).
# Format: KEY=VALUE only. No quotes, no "export", no comment after a value.
#
# This file holds no secrets. The tunnel token is app state in the data volume
# (/data/.tunnel_token, mode 0600), set from the GUI's Config page or its Apporo Link.
#
# The defaults differ from WOOW's Cloudflare Tunnel Web GUI (cf_data, 18000, 20241, 8888),
# so both can run on one host. install.sh refuses WOOW's default ports, a WOOW volume
# (cf_data, <project>_cf_data, woow*, cf-tunnel-webgui*, or one podman says is another app's)
# and a path in WOOW's config dir (~/.config/woow-cf-tunnel).

# Data volume. Created on the first install; uninstall.sh keeps it unless --purge.
CF_DATA_VOLUME=apporo_cf_data

# GUI/API port. The unit always binds it to 127.0.0.1.
UVICORN_PORT=18100

# cloudflared metrics/readiness endpoint (--metrics), probed by the healthcheck.
# It must stay on 127.0.0.1: with host networking, 0.0.0.0 would publish /config
# (the full ingress map) to the LAN. install.sh refuses anything else.
CF_METRICS_ADDR=127.0.0.1:20341

# Optional Basic-auth proxy (scripts/install.sh --with-auth).
# Listen address. Use 0.0.0.0:<port> only when the LAN must reach the GUI.
AUTH_LISTEN=127.0.0.1:8988
# htpasswd file, created with scripts/auth-passwd.sh USER. %h is your home directory.
AUTH_HTPASSWD=%h/.config/apporo-cf-tunnel/htpasswd
