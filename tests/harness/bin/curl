#!/usr/bin/env bash
# Mock curl for tests/harness: answers for cloudflared's metrics server (/ready, /config),
# the GUI (/api/health), the auth proxy and three public hostnames, from $MOCK_STATE. Every
# URL is logged to calls.log ("curl <url>"; never a credential), so a probe that reached
# WOOW's GUI instead of ours shows up there.
#
# The /config body mirrors what a live connector sends (captured from cloudflared 2026.6.1):
# every ingress rule carries the hostname key, and the catch-all carries it with an EMPTY
# value rather than omitting it. That is load-bearing -- a mock that omitted the key let
# cf_ingress_map's dict default hide a bug that refused a real swap
# (see tests/cf-gate-ingress.sh).
# /ready likewise carries connectorId beside status and readyConnections. Only the 200 body
# was read off a live connector; the 503 warm-up body is this mock's own, and no caller
# reads either field beyond readyConnections.
# Knobs: MOCK_SCENARIO (never_ready | version_changed | public_mismatch | broken_config; all
#                       but broken_config only while the new image MOCK_NEW_IMAGE runs),
#        MOCK_BAD_IMAGE (a running image that never gets edge connections),
#        MOCK_WARMUP (/ready calls answered 503 after each start of the new unit; default 2),
#        MOCK_NO_METRICS (nothing listens on the metrics port: an unconfigured or crashed
#                         tunnel, so every /ready and /config call is refused),
#        MOCK_WOOW=1 (WOOW's GUI runs on its own defaults: GUI 18000, metrics 20241,
#                     auth proxy 8888; woow_host in common.sh).
# Our units answer on the ports they were (re)started with (running_gui, running_metrics,
# running_auth; default 18100, 127.0.0.1:20341, 8988), so an upgrade that moves a port is
# probed where each unit really listens.
set -u
S=${MOCK_STATE:?}
st() { cat "$S/$1" 2>/dev/null || echo "${2:-0}"; }
run_val() { local v; v=$(cat "$S/$1" 2>/dev/null); printf '%s' "${v:-$2}"; }
M=$(run_val running_metrics 127.0.0.1:20341)
G=$(run_val running_gui 18100)
AP=$(run_val running_auth 127.0.0.1:8988)
AP=${AP##*:}
url='' wfmt='' prev='' auth=0
for a in "$@"; do
  case $a in http*) url=$a ;; esac
  [[ $prev == -w ]] && wfmt=$a
  [[ $prev == -K || $prev == -u ]] && auth=1
  prev=$a
done
echo "curl $url" >>"$S/calls.log"
N=$(st units/apporo-cf-tunnel.service/active 0)
A=$(st units/apporo-cf-tunnel-auth.service/active 0)
W=${MOCK_WOOW:-0}
sc=${MOCK_SCENARIO:-happy}
img=$(st running_image '')
bad_image=0 new_image=0
[[ $N == 1 && -n ${MOCK_BAD_IMAGE:-} && $img == "$MOCK_BAD_IMAGE" ]] && bad_image=1
[[ $N == 1 && -n ${MOCK_NEW_IMAGE:-} && $img == "$MOCK_NEW_IMAGE" ]] && new_image=1
body='' code=200
# the container shares the host netns, so the metrics port is only open while cloudflared
# itself runs: with no token (or a bogus one) the connection is refused, unit active or not
if [[ ${MOCK_NO_METRICS:-0} == 1 && $url == "http://$M/"* ]]; then exit 7; fi
case $url in
  "http://$M/ready")
    [[ $N == 1 ]] || exit 7
    c=$(($(st new_ready_calls) + 1))
    echo "$c" >"$S/new_ready_calls"
    if [[ ($sc == never_ready && $new_image == 1) || $bad_image == 1 || $c -le ${MOCK_WARMUP:-2} || (-e $S/soaking && $new_image == 1) ]]; then
      body='{"status":503,"readyConnections":0}' code=503
    else
      body='{"status":200,"readyConnections":4,"connectorId":"00000000-0000-4000-8000-000000000000"}'
    fi ;;
  "http://$M/config")
    [[ $N == 1 ]] || exit 7
    v=28
    [[ $sc == version_changed && $new_image == 1 ]] && v=29
    body="{\"version\":$v,\"config\":{\"ingress\":[{\"hostname\":\"a.example.io\",\"service\":\"http://localhost:8123\"},{\"hostname\":\"ssh.example.io\",\"service\":\"ssh://localhost:22\"},{\"hostname\":\"dead.example.io\",\"service\":\"http://localhost:8787\"},{\"hostname\":\"\",\"service\":\"http_status:404\"}]}}"
    [[ $sc == broken_config ]] && body='not json' ;;
  # WOOW's connector on its own metrics port: a different tunnel, always ready
  http://127.0.0.1:20241/ready)
    [[ $W == 1 ]] || exit 7
    body='{"status":200,"readyConnections":4,"connectorId":"11111111-1111-4111-8111-111111111111"}' ;;
  http://127.0.0.1:20241/config)
    [[ $W == 1 ]] || exit 7
    body='{"version":7,"config":{"ingress":[{"hostname":"woow.example.io","service":"http://localhost:8123"},{"hostname":"","service":"http_status:404"}]}}' ;;
  http://127.0.0.1:*)
    port=${url#http://127.0.0.1:}
    path=/${port#*/}
    port=${port%%/*}
    if [[ ($port == "$G" && $N == 1) || ($port == 18000 && $W == 1) ]]; then
      [[ $path == /api/health ]] || exit 6
      body='{"status":"ok","process_running":true}'
    elif [[ ($port == "$AP" && $A == 1) || ($port == 8888 && $W == 1) ]]; then
      case $path in
        /healthz) code=204 ;;
        *) if ((auth)); then code=200; else code=401; fi ;;
      esac
    else
      exit 7
    fi ;;
  https://a.example.io/)
    if [[ $N == 1 ]]; then code=200; else code=530; fi
    [[ $sc == public_mismatch && $new_image == 1 ]] && code=502 ;;
  https://ssh.example.io/) if [[ $N == 1 ]]; then code=200; else code=530; fi ;;
  https://dead.example.io/) if [[ $N == 1 ]]; then code=502; else code=530; fi ;;
  *) exit 6 ;;
esac
# -f: fail on HTTP >= 400 like the real curl
for a in "$@"; do [[ $a == -f* || $a == -*f ]] && ((code >= 400)) && exit 22; done
if [[ -n $wfmt ]]; then printf '%s' "$code"; else printf '%s' "$body"; fi
