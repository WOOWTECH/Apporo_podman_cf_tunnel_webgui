#!/usr/bin/env bash
# Mock podman for tests/harness; never touches real containers. State in $MOCK_STATE
# (see the systemctl mock) plus images/<ref with / : @ as _>.
# MOCK_SCENARIO=unhealthy: the new image (MOCK_NEW_IMAGE) never reports healthy.
# MOCK_BAD_IMAGE=<ref>: a container running that image never becomes healthy.
# MOCK_VOLUMES: the volumes that exist (default apporo_cf_data, the one the volume unit
#   creates). MOCK_WOOW=1: WOOW's containers (woow-cf-tunnel, woow-cf-tunnel-auth,
#   cf-tunnel-webgui) exist and run, next to ours (woow_host in common.sh).
# MOCK_VOLUME_LABELS / MOCK_VOLUME_COMPOSE / MOCK_VOLUME_USERS: "<volume>=<value> ..." -- what
#   `podman volume inspect` says of a volume's io.woowtech.app label and compose project, and
#   which other containers `podman ps -a --filter volume=` lists (ours is listed while it runs)
set -u
S=${MOCK_STATE:?}
echo "podman $*" >>"$S/calls.log"
st() { cat "$S/$1" 2>/dev/null || echo "${2:-0}"; }
of() { local e; for e in $1; do [[ ${e%%=*} == "$2" ]] && printf '%s\n' "${e#*=}"; done; return 0; }
run_val() { local v; v=$(cat "$S/$1" 2>/dev/null); printf '%s' "${v:-$2}"; }
ikey() { printf '%s' "${1//[\/:@]/_}"; }
new_up() { [[ $(st units/apporo-cf-tunnel.service/active 0) == 1 ]]; }
new_healthy() {
  local img
  new_up || return 1
  img=$(st running_image '')
  [[ ${MOCK_SCENARIO:-} == unhealthy && -n ${MOCK_NEW_IMAGE:-} && $img == "$MOCK_NEW_IMAGE" ]] && return 1
  [[ -z ${MOCK_BAD_IMAGE:-} || $img != "$MOCK_BAD_IMAGE" ]]
}
woow_ctr() { [[ ${MOCK_WOOW:-0} == 1 && " woow-cf-tunnel woow-cf-tunnel-auth cf-tunnel-webgui " == *" $1 "* ]]; }
[[ ${1:-} == --version ]] && { echo "podman version 4.9.3"; exit 0; }
cmd=${1:-}
shift || true
case $cmd in
  build)
    img=''
    while (($#)); do [[ $1 == -t ]] && { img=$2; shift; }; shift; done
    [[ ${MOCK_BUILD_FAIL:-0} == 1 ]] && { echo "mock: build failed" >&2; exit 1; }
    mkdir -p "$S/images"; : >"$S/images/$(ikey "$img")"; exit 0 ;;
  image)
    case ${1:-} in
      exists) [[ -e $S/images/$(ikey "$2") ]]; exit ;;
    esac
    exit 0 ;;
  pull) mkdir -p "$S/images"; : >"$S/images/$(ikey "${!#}")"; exit 0 ;;
  unshare)
    case ${1:-} in
      chgrp) echo "chgrp $2 $3" >>"$S/chgrp.log"; exit 0 ;;
      sh) [[ ${MOCK_NO_HEALTHCHECK:-0} == 1 ]] && exit 1; exit 0 ;;
    esac
    exit 0 ;;
  container)
    case ${1:-} in
      exists)
        case $2 in
          apporo-cf-tunnel) new_up ;;
          *) woow_ctr "$2" ;;
        esac
        exit ;;
    esac
    exit 0 ;;
  inspect)
    fmt='' iargs=()
    while (($#)); do
      case $1 in
        -f | --format) fmt=$2; shift 2 ;;
        --size) shift ;;
        *) iargs+=("$1"); shift ;;
      esac
    done
    set -- "${iargs[@]:-}"
    name=${1:-}
    case $name in
      apporo-cf-tunnel)
        new_up || exit 125
        case $fmt in
          *PODMAN_SYSTEMD_UNIT*) echo apporo-cf-tunnel.service ;;
          *State.Status*'|'*) if new_healthy; then echo "running|hc|healthy|2026-09-12T00:00:00Z"; else echo "running|hc|unhealthy|2026-09-12T00:00:00Z"; fi ;;
          *State.Health.Status*) if new_healthy; then echo healthy; else echo unhealthy; fi ;;
          *HealthcheckOnFailureAction*) echo kill ;;
          *Config.Env*) printf 'UVICORN_HOST=127.0.0.1\nUVICORN_PORT=%s\nCF_METRICS_ADDR=%s\n' \
            "$(run_val running_gui 18100)" "$(run_val running_metrics 127.0.0.1:20341)" ;;
          '') echo '[{"Name":"apporo-cf-tunnel"}]' ;;
        esac ;;
      apporo-cf-tunnel-auth)
        [[ $(st units/apporo-cf-tunnel-auth.service/active 0) == 1 ]] || exit 125
        case $fmt in *PODMAN_SYSTEMD_UNIT*) echo apporo-cf-tunnel-auth.service ;; esac ;;
      *)
        woow_ctr "$name" || exit 125 ;;
    esac
    exit 0 ;;
  volume)
    case ${1:-} in
      exists) [[ " ${MOCK_VOLUMES:-apporo_cf_data} " == *" $2 "* ]]; exit ;;
      inspect)
        if [[ $* == *compose* ]]; then of "${MOCK_VOLUME_COMPOSE:-}" "${!#}"; else of "${MOCK_VOLUME_LABELS:-}" "${!#}"; fi
        exit 0 ;;
      export)
        printf 'settings.json\n.tunnel_token\n.csrf_secret\n' >"$S/vol.list"
        tar -cf "$4" -C "$S" vol.list; exit ;;
      import) echo "import $2 $3" >>"$S/import.log"; exit 0 ;;
    esac
    exit 0 ;;
  ps)
    if [[ " $* " == *volume=* ]] && new_up; then echo apporo-cf-tunnel; fi
    for a in "$@"; do [[ $a == volume=* ]] && of "${MOCK_VOLUME_USERS:-}" "${a#volume=}"; done
    exit 0 ;;
  healthcheck) new_healthy; exit ;;
  *) exit 0 ;;
esac
