#!/usr/bin/env bash
# Mock `systemctl --user` for tests/harness. State lives in $MOCK_STATE:
#   units/<unit>/active   Quadlet-generated units (apporo-cf-tunnel*.service), 0/1
#   loaded                units the "generator" produced at the last daemon-reload
#   running_image         Image= of apporo-cf-tunnel.container at its last (re)start
#   running_gui, running_metrics, running_auth
#                         the ports the units listen on, from their files at the last (re)start
#                         (UVICORN_PORT, CF_METRICS_ADDR, auth-nginx.conf's listen address)
#   new_nrestarts         NRestarts of apporo-cf-tunnel.service
#   woow/<unit>           a unit of WOOW's GUI on the same host (woow_host in common.sh):
#                         loaded while the file exists, active while it holds 1. Nothing in
#                         this package may act on it; the mock carries out whatever it is
#                         asked, so woow_untouched sees the result.
set -u
S=${MOCK_STATE:?}
echo "systemctl $*" >>"$S/calls.log"
[[ ${1:-} == --user ]] && shift
Q=$HOME/.config/containers/systemd
st() { cat "$S/$1" 2>/dev/null || echo "${2:-0}"; }
kind() {
  case $1 in
    apporo-cf-tunnel.service | apporo-cf-tunnel-auth.service | apporo-cf-tunnel-data-volume.service) echo quadlet ;;
    apporo-cf-tunnel-upgrade-*) echo transient ;;
    *) if [[ -e $S/woow/$1 ]]; then echo woow; else echo other; fi ;;
  esac
}
loaded() { grep -qx "$1" "$S/loaded" 2>/dev/null; }
active() {
  case $(kind "$1") in
    quadlet) [[ $(st "units/$1/active" 0) == 1 ]] ;;
    woow) [[ $(st "woow/$1" 0) == 1 ]] ;;
    *) return 1 ;;
  esac
}
set_active() {
  case $(kind "$1") in
    quadlet)
      mkdir -p "$S/units/$1"
      echo "$2" >"$S/units/$1/active"
      if [[ $1 == apporo-cf-tunnel.service && $2 == 1 ]]; then
        sed -n 's/^Image=//p' "$Q/apporo-cf-tunnel.container" >"$S/running_image"
        sed -n 's/^Environment=UVICORN_PORT=//p' "$Q/apporo-cf-tunnel.container" >"$S/running_gui"
        sed -n 's/^Environment=CF_METRICS_ADDR=//p' "$Q/apporo-cf-tunnel.container" >"$S/running_metrics"
        echo 0 >"$S/new_ready_calls"
        mkdir -p "$S/units/apporo-cf-tunnel-data-volume.service"
        echo 1 >"$S/units/apporo-cf-tunnel-data-volume.service/active"
      fi
      if [[ $1 == apporo-cf-tunnel-auth.service && $2 == 1 ]]; then
        sed -n 's/^[[:space:]]*listen[[:space:]][[:space:]]*\([^;[:space:]]*\).*/\1/p' \
          "$HOME/.config/apporo-cf-tunnel/auth-nginx.conf" >"$S/running_auth" 2>/dev/null
      fi ;;
    woow) echo "$2" >"$S/woow/$1" ;;
  esac
}
prop() {
  local u=$1 p=$2
  case $p in
    LoadState)
      case $(kind "$u") in
        quadlet) if loaded "$u"; then echo loaded; else echo not-found; fi ;;
        woow) echo loaded ;;
        *) echo not-found ;;
      esac ;;
    FragmentPath)
      case $(kind "$u") in
        quadlet) loaded "$u" && echo "/run/user/1000/systemd/generator/$u" ;;
        woow) echo "/run/user/1000/systemd/generator/$u" ;;
      esac ;;
    UnitFileState)
      case $(kind "$u") in
        quadlet) loaded "$u" && echo generated ;;
        woow) echo generated ;;
      esac ;;
    ActiveState) if active "$u"; then echo active; else echo inactive; fi ;;
    NRestarts) if [[ $u == apporo-cf-tunnel.service ]]; then st new_nrestarts 0; else echo 0; fi ;;
    *) echo "" ;;
  esac
}
cmd=${1:-}
shift || true
case $cmd in
  show-environment | reset-failed | cat) exit 0 ;;
  daemon-reload)
    : >"$S/loaded"
    for f in "$Q"/apporo-cf-tunnel.container "$Q"/apporo-cf-tunnel-auth.container; do
      [[ -f $f ]] && basename "$f" .container | sed 's/$/.service/' >>"$S/loaded"
    done
    [[ -f $Q/apporo-cf-tunnel-data.volume ]] && echo apporo-cf-tunnel-data-volume.service >>"$S/loaded"
    exit 0 ;;
  show)
    p='' u=''
    while (($#)); do
      case $1 in -p) p=$2; shift ;; --value) ;; *) u=$1 ;; esac
      shift
    done
    prop "$u" "$p"; exit 0 ;;
  is-active)
    q=0
    [[ ${1:-} == --quiet ]] && { q=1; shift; }
    if active "$1"; then ((q)) || echo active; exit 0; fi
    ((q)) || echo inactive; exit 3 ;;
  is-enabled)
    s=$(prop "$1" UnitFileState); echo "${s:-disabled}"; [[ $s == enabled ]]; exit ;;
  start | restart)
    for u in "$@"; do
      [[ $(prop "$u" LoadState) == loaded ]] || { echo "Unit $u not found." >&2; exit 5; }
      [[ " ${MOCK_FAIL_START:-} " == *" $u "* ]] && { echo "Job for $u failed." >&2; exit 1; }
      if [[ $cmd == start ]] && active "$u"; then continue; fi
      set_active "$u" 1
    done
    exit 0 ;;
  stop | kill)
    for u in "$@"; do [[ $u == -* ]] || set_active "$u" 0; done; exit 0 ;;
  enable)
    now=0
    [[ ${1:-} == --now ]] && { now=1; shift; }
    if ((now)); then for u in "$@"; do set_active "$u" 1; done; fi
    exit 0 ;;
  disable) exit 0 ;;
  *) exit 0 ;;
esac
